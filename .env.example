# ─── LLM (endpoint tương thích OpenAI) ───────────────────────────────
# Có thể dùng: mô hình self-host (vLLM/Ollama), OpenAI, hoặc Gemini qua lớp openai-compat.
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=not-needed
MODEL=gpt-4o-mini

# ─── Web search ──────────────────────────────────────────────────────
# Có khóa serper.dev -> tìm Google (tốt hơn). Bỏ trống -> dùng DuckDuckGo miễn phí.
SERPER_API_KEY=

# ─── Tham số nghiên cứu ──────────────────────────────────────────────
MAX_RESEARCH_LOOPS=2
QUERIES_PER_ROUND=3
RESULTS_PER_QUERY=4
MAX_PAGE_CHARS=6000
